rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roomParticipant(roomId) {
      let room = get(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId));
      return signedIn()
        && (room.data.members.a == request.auth.uid || room.data.members.b == request.auth.uid);
    }

    function roomRole(roomId) {
      let room = get(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId));
      return room.data.members.a == request.auth.uid ? 'a' : 'b';
    }

    match /artifacts/our-little-room/public/data/rooms/{roomId} {
      function isMember(data) {
        return request.auth != null
          && (data.members.a == request.auth.uid || data.members.b == request.auth.uid);
      }

      function photoBoothUpdateAllowed() {
        let oldBooth = resource.data.get('photoBooth', {'selfies': {'a': '', 'b': ''}});
        let newBooth = request.resource.data.get('photoBooth', {'selfies': {'a': '', 'b': ''}});
        let role = roomRole(roomId);
        let otherRole = role == 'a' ? 'b' : 'a';
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoBooth'])
          || (
            newBooth is map
            && newBooth.keys().hasOnly(['selfies', 'updatedAt'])
            && newBooth.keys().hasAll(['selfies', 'updatedAt'])
            && newBooth.selfies is map
            && newBooth.selfies.keys().hasOnly(['a', 'b'])
            && newBooth.selfies.keys().hasAll(['a', 'b'])
            && newBooth.selfies[otherRole] == oldBooth.get('selfies', {'a': '', 'b': ''})[otherRole]
            && newBooth.selfies[role] is string
            && newBooth.selfies[role].size() <= 100
            && (
              newBooth.selfies[role] == ''
              || newBooth.selfies[role].matches(
                role == 'a' ? 'a-[a-zA-Z0-9-]+[.]jpg' : 'b-[a-zA-Z0-9-]+[.]jpg'
              )
            )
            && newBooth.updatedAt is int
          );
      }

      function photoBoothPairReady() {
        let room = get(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId));
        let selfies = room.data.get('photoBooth', {'selfies': {'a': '', 'b': ''}}).get(
          'selfies',
          {'a': '', 'b': ''}
        );
        return selfies.a is string && selfies.a != ''
          && selfies.b is string && selfies.b != ''
          && exists(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId)/photoBooth/$(selfies.a))
          && exists(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId)/photoBooth/$(selfies.b));
      }

      function photoBoothFileIsActive(fileName) {
        let room = get(/databases/$(database)/documents/artifacts/our-little-room/public/data/rooms/$(roomId));
        let selfies = room.data.get('photoBooth', {'selfies': {'a': '', 'b': ''}}).get(
          'selfies',
          {'a': '', 'b': ''}
        );
        return selfies.a == fileName || selfies.b == fileName;
      }

      function photoBoothFileBelongsToCurrentUser(fileName) {
        return (
          fileName.matches('a-[a-zA-Z0-9-]+[.]jpg') && roomRole(roomId) == 'a'
        ) || (
          fileName.matches('b-[a-zA-Z0-9-]+[.]jpg') && roomRole(roomId) == 'b'
        );
      }

      allow create: if signedIn()
        && request.resource.data.members.a == request.auth.uid
        && request.resource.data.members.b == null
        && !request.resource.data.keys().hasAny(['photoBooth']);

      // The invite code opens an unclaimed room; after it is claimed, members alone can read it.
      allow get: if signedIn()
        && (isMember(resource.data) || resource.data.members.b == null);

      allow list: if false;

      allow update: if (
        isMember(resource.data)
        && request.resource.data.members == resource.data.members
        && photoBoothUpdateAllowed()
      ) || (
        signedIn()
        && resource.data.members.b == null
        && request.resource.data.members.a == resource.data.members.a
        && request.resource.data.members.b == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'names'])
      );

      allow delete: if false;

      match /photoBoothNotes/{role} {
        function validNote(data) {
          return data.keys().hasOnly(['hint', 'updatedAt'])
            && data.keys().hasAll(['hint', 'updatedAt'])
            && data.hint is string
            && data.hint.size() <= 250
            && data.updatedAt is int;
        }

        allow read: if roomParticipant(roomId);
        allow create: if roomParticipant(roomId)
          && (role == 'a' || role == 'b')
          && role == roomRole(roomId)
          && validNote(request.resource.data);
        allow update: if roomParticipant(roomId)
          && role == roomRole(roomId)
          && validNote(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hint', 'updatedAt']);
        allow delete: if false;
      }

      match /photoBooth/{fileName} {
        allow read: if roomParticipant(roomId)
          && photoBoothPairReady()
          && photoBoothFileIsActive(fileName);
        allow create: if roomParticipant(roomId)
          && photoBoothFileBelongsToCurrentUser(fileName)
          && request.resource.data.keys().hasOnly(['image', 'createdAt'])
          && request.resource.data.keys().hasAll(['image', 'createdAt'])
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 400000
          && request.resource.data.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}')
          && request.resource.data.createdAt is int;
        allow update: if false;
        allow delete: if roomParticipant(roomId)
          && photoBoothFileBelongsToCurrentUser(fileName)
          && !photoBoothFileIsActive(fileName);
      }

      match /memories/{memoryId} {
        allow read: if roomParticipant(roomId);
        allow create: if roomParticipant(roomId)
          && request.resource.data.keys().hasOnly(['place', 'date', 'note', 'thoughts', 'photos', 'selfies', 'createdAt', 'createdBy'])
          && request.resource.data.keys().hasAll(['place', 'date', 'note', 'thoughts', 'photos', 'selfies', 'createdAt', 'createdBy'])
          && request.resource.data.place is string
          && request.resource.data.place.size() > 0
          && request.resource.data.place.size() <= 60
          && request.resource.data.date is string
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.thoughts is map
          && request.resource.data.thoughts.keys().hasOnly(['a', 'b'])
          && request.resource.data.thoughts.keys().hasAll(['a', 'b'])
          && request.resource.data.thoughts[roomRole(roomId)] is string
          && request.resource.data.thoughts[roomRole(roomId)].size() > 0
          && request.resource.data.thoughts[roomRole(roomId)].size() <= 250
          && request.resource.data.thoughts[roomRole(roomId) == 'a' ? 'b' : 'a'] == ''
          && request.resource.data.photos is list
          && request.resource.data.photos.size() <= 4
          && request.resource.data.selfies is map
          && request.resource.data.selfies.keys().hasOnly(['a', 'b'])
          && request.resource.data.selfies.keys().hasAll(['a', 'b'])
          && request.resource.data.selfies.a == ''
          && request.resource.data.selfies.b == ''
          && request.resource.data.createdAt is int
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if roomParticipant(roomId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thoughts', 'selfies'])
          && request.resource.data.thoughts is map
          && request.resource.data.thoughts.keys().hasOnly(['a', 'b'])
          && request.resource.data.thoughts.keys().hasAll(['a', 'b'])
          && (
            request.resource.data.thoughts[roomRole(roomId)]
              == resource.data.get('thoughts', {'a': '', 'b': ''})[roomRole(roomId)]
            || (
              request.resource.data.thoughts[roomRole(roomId)] is string
              && request.resource.data.thoughts[roomRole(roomId)].size() > 0
              && request.resource.data.thoughts[roomRole(roomId)].size() <= 250
            )
          )
          && request.resource.data.thoughts[roomRole(roomId) == 'a' ? 'b' : 'a']
            == resource.data.get('thoughts', {'a': '', 'b': ''})[roomRole(roomId) == 'a' ? 'b' : 'a']
          && request.resource.data.selfies is map
          && request.resource.data.selfies.keys().hasOnly(['a', 'b'])
          && request.resource.data.selfies.keys().hasAll(['a', 'b'])
          && request.resource.data.selfies[roomRole(roomId) == 'a' ? 'b' : 'a']
            == resource.data.get('selfies', {'a': '', 'b': ''})[roomRole(roomId) == 'a' ? 'b' : 'a']
          && (
            request.resource.data.selfies[roomRole(roomId)]
              == resource.data.get('selfies', {'a': '', 'b': ''})[roomRole(roomId)]
            || (
              request.resource.data.selfies[roomRole(roomId)] is string
              && request.resource.data.selfies[roomRole(roomId)].size() > 0
              && request.resource.data.selfies[roomRole(roomId)].size() <= 100
              && request.resource.data.selfies[roomRole(roomId)].matches(
                roomRole(roomId) == 'a' ? 'a-[a-zA-Z0-9-]+[.]jpg' : 'b-[a-zA-Z0-9-]+[.]jpg'
              )
            )
          );
        allow delete: if false;
      }
    }
  }
}
